generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(cuid())
  email            String                @unique
  emailVerified    DateTime?
  name             String
  password         String?
  image            String?
  avatar           String?
  role             String                @default("student")
  bio              String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  accounts         Account[]
  blogComments     BlogComment[]
  blogPosts        BlogPost[]
  books            Book[]
  progress         CourseProgress[]
  courses          Course[]              @relation("InstructorCourses")
  documentaries    Documentary[]
  downloads        Download[]
  enrollments      Enrollment[]
  galleryImages    GalleryImage[]
  listeningHistory ListeningHistory[]
  noteBookmarks    NoteBookmark[]
  notes            Note[]
  orders           Order[]
  otpCodes         OtpCode[]
  playlists        Playlist[]
  podcastEpisodes  PodcastEpisode[]
  favorites        PodcastFavorite[]
  subscriptions    PodcastSubscription[]
  podcasts         Podcast[]
  purchases        Purchase[]
  quizAttempts     QuizAttempt[]
  quizzes          Quiz[]
  researchPapers   ResearchPaper[]
  reviews          Review[]
  sessions         Session[]
  storeProducts    StoreProduct[]
  studyMaterials   StudyMaterial[]
  videos           Video[]
  wallpapers       Wallpaper[]
  watchProgress    WatchProgress[]
  watchlistItems   WatchlistItem[]

  @@map("users")
}

model Wallpaper {
  id             String   @id @default(cuid())
  imageUrl       String
  position       String   @default("center")
  size           String   @default("cover")
  overlayOpacity Float    @default(0.5)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  uploaderId     String
  uploader       User     @relation(fields: [uploaderId], references: [id])

  @@map("wallpapers")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String   @default("login")
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([email, code, purpose])
  @@map("otp_codes")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  courses     Course[]

  @@map("categories")
}

model Course {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  String
  thumbnail    String?
  price        Float        @default(0)
  level        String       @default("beginner")
  duration     String?
  published    Boolean      @default(false)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  instructorId String
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id])
  instructor   User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrollments  Enrollment[]
  modules      Module[]
  reviews      Review[]

  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  courseId    String
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model Lesson {
  id        String           @id @default(cuid())
  title     String
  content   String?
  videoUrl  String?
  duration  String?
  order     Int
  createdAt DateTime         @default(now())
  moduleId  String
  progress  CourseProgress[]
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  status      String    @default("active")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  userId      String
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@map("reviews")
}

model CourseProgress {
  id        String   @id @default(cuid())
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  userId    String
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@map("course_progress")
}

model Note {
  id            String         @id @default(cuid())
  title         String
  description   String?
  content       String?
  subject       String
  topic         String?
  mediaCategory String         @default("General")
  fileType      String         @default("markdown")
  fileName      String?
  fileSize      Int?
  fileUrl       String?
  thumbnail     String?
  downloads     Int            @default(0)
  published     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  authorId      String
  isFree        Boolean        @default(true)
  price         Float          @default(0)
  salePrice     Float?
  bookmarks     NoteBookmark[]
  tags          NoteTag[]
  author        User           @relation(fields: [authorId], references: [id])

  @@index([subject, topic])
  @@index([authorId])
  @@index([mediaCategory])
  @@map("notes")
}

model NoteBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, noteId])
  @@map("note_bookmarks")
}

model NoteTag {
  id     String @id @default(cuid())
  name   String
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, name])
  @@map("note_tags")
}

model GalleryImage {
  id           String   @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  category     String   @default("General")
  tags         String?
  width        Int?
  height       Int?
  fileSize     Int?
  downloads    Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])

  @@index([category])
  @@index([uploaderId])
  @@map("gallery_images")
}

model Video {
  id            String          @id @default(cuid())
  title         String
  description   String?
  youtubeUrl    String
  youtubeId     String
  thumbnailUrl  String?
  duration      Int?
  category      String          @default("General")
  tags          String?
  views         Int             @default(0)
  featured      Boolean         @default(false)
  published     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  uploaderId    String
  playlistItems PlaylistItem[]
  uploader      User            @relation(fields: [uploaderId], references: [id])
  watchProgress WatchProgress[]

  @@index([category])
  @@index([uploaderId])
  @@map("videos")
}

model Playlist {
  id          String         @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  creatorId   String
  items       PlaylistItem[]
  creator     User           @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  order      Int
  playlistId String
  videoId    String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@map("playlist_items")
}

model WatchProgress {
  id              String   @id @default(cuid())
  currentTime     Float    @default(0)
  completed       Boolean  @default(false)
  percentComplete Float    @default(0)
  updatedAt       DateTime @updatedAt
  userId          String
  videoId         String
  user            User     @relation(fields: [userId], references: [id])
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("watch_progress")
}

model Documentary {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  description    String
  posterUrl      String?
  trailerUrl     String?
  duration       String?
  year           Int?
  director       String?
  rating         Float?
  category       String          @default("General")
  tags           String?
  featured       Boolean         @default(false)
  published      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  uploaderId     String
  uploader       User            @relation(fields: [uploaderId], references: [id])
  watchlistItems WatchlistItem[]

  @@index([category])
  @@map("documentaries")
}

model WatchlistItem {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  userId        String
  documentaryId String
  documentary   Documentary @relation(fields: [documentaryId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, documentaryId])
  @@map("watchlist_items")
}

model Podcast {
  id            String                @id @default(cuid())
  title         String
  slug          String                @unique
  description   String
  author        String
  coverUrl      String?
  category      String                @default("General")
  tags          String?
  episodeCount  Int                   @default(0)
  featured      Boolean               @default(false)
  published     Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  creatorId     String
  episodes      PodcastEpisode[]
  favorites     PodcastFavorite[]
  subscriptions PodcastSubscription[]
  creator       User                  @relation(fields: [creatorId], references: [id])

  @@index([category])
  @@map("podcasts")
}

model PodcastEpisode {
  id               String             @id @default(cuid())
  title            String
  description      String?
  audioUrl         String
  duration         Int?
  episodeNumber    Int                @default(1)
  seasonNumber     Int                @default(1)
  published        Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  podcastId        String
  uploaderId       String
  listeningHistory ListeningHistory[]
  podcast          Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  uploader         User               @relation(fields: [uploaderId], references: [id])

  @@index([podcastId])
  @@map("podcast_episodes")
}

model PodcastFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  podcastId String
  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, podcastId])
  @@map("podcast_favorites")
}

model PodcastSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  podcastId String
  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, podcastId])
  @@map("podcast_subscriptions")
}

model ListeningHistory {
  id              String         @id @default(cuid())
  currentTime     Float          @default(0)
  percentComplete Float          @default(0)
  completed       Boolean        @default(false)
  updatedAt       DateTime       @updatedAt
  userId          String
  episodeId       String
  episode         PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id])

  @@unique([userId, episodeId])
  @@map("listening_history")
}

model Quiz {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  description  String?
  subject      String
  category     String         @default("General")
  difficulty   String         @default("medium")
  timeLimit    Int?
  passingScore Int            @default(70)
  published    Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  creatorId    String
  attempts     QuizAttempt[]
  questions    QuizQuestion[]
  creator      User           @relation(fields: [creatorId], references: [id])

  @@index([subject, category])
  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(cuid())
  question      String
  type          String  @default("multiple-choice")
  options       String
  correctAnswer String
  explanation   String?
  order         Int     @default(0)
  points        Int     @default(1)
  quizId        String
  quiz          Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id           String   @id @default(cuid())
  answers      String
  score        Float
  totalPoints  Int
  earnedPoints Int
  passed       Boolean
  timeTaken    Int?
  completedAt  DateTime @default(now())
  userId       String?
  quizId       String
  guestName    String?
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        String
  category       String
  readTime       String        @default("5 min")
  coverImage     String?
  published      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  authorId       String
  seoDescription String?
  seoTitle       String?
  subcategory    String?
  tags           String?
  comments       BlogComment[]
  author         User          @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([category])
  @@index([authorId])
  @@map("blog_posts")
}

model BlogComment {
  id         String        @id @default(cuid())
  content    String
  parentId   String?
  likes      Int           @default(0)
  hidden     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  userId     String?
  blogPostId String
  guestName  String?
  blogPost   BlogPost      @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  parent     BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    BlogComment[] @relation("CommentReplies")
  user       User?         @relation(fields: [userId], references: [id])

  @@index([blogPostId])
  @@index([userId])
  @@map("blog_comments")
}

model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  author      String
  type        String   @default("Book")
  status      String   @default("Reading")
  description String?
  coverUrl    String?
  link        String?
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("study_materials")
}

model Book {
  id              String      @id @default(cuid())
  title           String
  author          String
  description     String?
  isbn            String?
  publisher       String?
  publicationYear Int?
  category        String      @default("Astronomy")
  subcategory     String?
  tags            String?
  coverImage      String?
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  previewUrl      String?
  externalLink    String?
  price           Float       @default(0)
  salePrice       Float?
  isFree          Boolean     @default(true)
  published       Boolean     @default(true)
  downloads       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  uploaderId      String
  uploader        User        @relation(fields: [uploaderId], references: [id])
  orderItems      OrderItem[]
  purchases       Purchase[]

  @@index([category, subcategory])
  @@index([uploaderId])
  @@map("books")
}

model ResearchPaper {
  id              String   @id @default(cuid())
  title           String
  authors         String
  abstract        String?
  journal         String?
  doi             String?
  publicationYear Int?
  category        String   @default("Astronomy")
  subcategory     String?
  keywords        String?
  researchArea    String?
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  externalLink    String?
  coverImage      String?
  downloads       Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  uploaderId      String
  uploader        User     @relation(fields: [uploaderId], references: [id])

  @@index([category])
  @@index([uploaderId])
  @@map("research_papers")
}

model StoreProduct {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        String
  category    String      @default("Astronomy")
  subcategory String?
  tags        String?
  coverImage  String?
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  previewUrl  String?
  price       Float       @default(0)
  salePrice   Float?
  isFree      Boolean     @default(true)
  published   Boolean     @default(true)
  downloads   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  uploaderId  String
  downloads2  Download[]
  orderItems  OrderItem[]
  purchases   Purchase[]
  uploader    User        @relation(fields: [uploaderId], references: [id])

  @@index([category, subcategory])
  @@index([type])
  @@index([uploaderId])
  @@map("store_products")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          String      @default("PENDING")
  totalAmount     Float
  currency        String      @default("INR")
  paymentProvider String?
  paymentId       String?
  paymentMethod   String?
  paymentVerified Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userId          String
  items           OrderItem[]
  user            User        @relation(fields: [userId], references: [id])
  payment         Payment?
  purchases       Purchase[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String        @id @default(cuid())
  price     Float
  quantity  Int           @default(1)
  orderId   String
  productId String?
  bookId    String?
  book      Book?         @relation(fields: [bookId], references: [id])
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   StoreProduct? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id                String    @id @default(cuid())
  provider          String
  providerPaymentId String?
  amount            Float
  currency          String    @default("INR")
  status            String    @default("created")
  method            String?
  metadata          String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id])

  @@index([providerPaymentId])
  @@map("payments")
}

model Purchase {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  userId    String
  productId String?
  bookId    String?
  orderId   String
  book      Book?         @relation(fields: [bookId], references: [id])
  order     Order         @relation(fields: [orderId], references: [id])
  product   StoreProduct? @relation(fields: [productId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@unique([userId, bookId])
  @@index([userId])
  @@map("purchases")
}

model Download {
  id        String        @id @default(cuid())
  fileUrl   String
  fileName  String?
  createdAt DateTime      @default(now())
  userId    String
  productId String?
  product   StoreProduct? @relation(fields: [productId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("downloads")
}

model Visitor {
  id          String   @id @default(cuid())
  ip          String?
  userAgent   String?
  page        String
  country     String?
  referer     String?
  sessionId   String?
  userId      String?
  createdAt   DateTime @default(now())
  countryCode String?
  visitorId   String?

  @@index([page])
  @@index([createdAt])
  @@index([sessionId])
  @@index([visitorId])
  @@map("visitors")
}
